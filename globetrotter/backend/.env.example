# ==============================================================================
# GlobeTrotter Backend Production Environment Variables
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# CORS Allowed Origins (Comma-separated for multiple domains)
CORS_ORIGIN=https://globetrotter-frontend.onrender.com,http://localhost:5173

# Database (Render Managed PostgreSQL or hosted Postgres)
DATABASE_URL=postgresql://user:password@hostname:5432/globetrotter

# Optional Redis Cache (Upstash / Redis Cloud)
REDIS_URL=redis://default:password@hostname:6379

# ==============================================================================
# Commercial Third-Party APIs (Optional - System auto-falls back to free APIs)
# ==============================================================================

# Mapbox (Geocoding & High-SLA Road Directions)
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSI...

# OpenWeatherMap (High-Volume Weather Telemetry)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ExchangeRate-API (Live Currency Conversion)
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here

# Razorpay / Stripe Payment Processing
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
